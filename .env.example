# ── Supabase (Project Settings → API) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<votre-projet>.supabase.co"
# Clé publique (publishable / anon)
NEXT_PUBLIC_SUPABASE_ANON_KEY="<cle-publishable-ou-anon>"
# Clé secrète (secret / service_role) — SERVEUR UNIQUEMENT, jamais commitée
SUPABASE_SERVICE_ROLE_KEY="<cle-secret-ou-service-role>"

# ── Application ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SUBSCRIPTION_PRICE_DZD="4000"
